#!/usr/bin/env bash
# base (one shared script file) should be in "${ROOT}/base", and it been
# been sourced in "${ROOT}/src/${package_name}.sh" files
_OLD="$(pwd)"
export ARCHT="${ARCHT:-$(gcc -dumpmachine)}"
export ARCHM="${ARCHM:-$(uname -m)}"
export ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "${ROOT}"
mkdir -p pool

while [ -n "$1" ]
do case "$1" in
	--with-cha|--with-chawan)
	export USECHAWAN=YES
	shift;;

	-v|--version)
	echo -n "git "
	git rev-parse HEAD
	exit 0;;

	-h|--help)
	cat <<EOD
usage: $0 {OPTION}

OPTIONS:
--with-cha  enables chawan support
--help      display this page
--version   display version
EOD
	exit 0;;
esac
done

pkgup() {
	local -r NAME="${1:-NONAME}"
	local -r HELPER="${ROOT}/src/${NAME}.sh" # NAME=$1
	if [ ! -f "$HELPER" ] ; then exit 13 ; fi # FAIL: dependency is not found
	"${HELPER}" setup
	test -f "${ROOT}/pool/${NAME}/ENV" && \
	source "${ROOT}/pool/${NAME}/ENV" # file with environtment variables

	local -r THIS="${ROOT}/pool/${NAME}"
	local -r DEPS="$($HELPER deps)"

	cd "${THIS}"
	local UPD=0

	mkdir -p "${THIS}/AppDir~"

	if [[ "$("${HELPER}" BREAK)" = *"DEPS"* ]]
	then echo "[pkgup] break: DEPS"
	else
		for D in $DEPS
		do
			local DEP="${D}" # Using new varaiable becouse without it `pkgup $D` rewrites D
			echo -n "[pkgup]  * $1: $DEP" # in [${DEPS[@]}]"
			# [ ! -f ... ] means that you should provide order in dependencies,
			# from specific (that has ranged, of course) to ranged.
			if [ ! -f "${THIS}~/AppDir/etc/pkgup/installed/${DEP}" ]
			then echo
				pkgup "$DEP" && UPD=1
				if [ ! -f "${ROOT}/pool/${DEP}/AppDir/etc/pkgup/installed/${DEP}" ]
				then echo "[pkgup] <! ${NAME}: ${DEP}"
					return 17
				fi
				cp -RTf "${ROOT}/pool/${DEP}/AppDir" "${THIS}/AppDir~"
			else echo " [already here]"
			fi
		done
	fi

	if [[ "$("${HELPER}" BREAK)" = *"INIT"* ]]
	then echo "[pkgup] break: INIT"
	else

		if   [ ! -d "${THIS}/src" ]
		then # Package is new
			mkdir -p "${THIS}/src"
			cd "${THIS}/src"
			"${HELPER}" init
			UPD=1
		fi

	[ ! -d "${THIS}/AppDir" ] && UPD=1 # Package is also new
	fi

	if [[ "$("${HELPER}" BREAK)" = *"UPDATE"* ]]
	then "[pkgup] break: UPDATE"
	else
		# So ${VER} is both marker that package localy installed and its version
		# also changes should be in "${THIS}/AppDir/etc/pkgup/changes/${NAME}"

		local VER_USED VER="${THIS}/AppDir/etc/pkgup/installed/${NAME}"
		test -f "${VER}" && VER_USED="$(cat "${VER}")"
		cd "${THIS}/src"
		mkdir -p "${THIS}/AppDir/etc/pkgup/changes" "${THIS}/AppDir~/etc/pkgup/changes"
		local VER_NEW="$("${HELPER}" update)"
	fi

	if [[ "$("${HELPER}" BREAK)" = *"BUILD"* ]]
	then "[pkgup] break: BUILD"
	else
		if   [ "$UPD" == 1 -o "$VER_USED" != "$VER_NEW" ]
		then # Updated or is new or is not $DEST
			rm -rf "${THIS}/AppDir"
			mv "${THIS}/AppDir~" "${THIS}/AppDir"

			mkdir -p "${THIS}/AppDir/etc/pkgup/installed"
			echo "${VER_NEW}" > "${VER}"

			cd "${THIS}/src"
			"${HELPER}" build || ( rm "${VER}"; echo "`tput setaf 1`[pkgup] nobuild: ${HELPER}`tput sgr0`" )
			echo "[pkgup] <+ $1"

		else # Nothing happens with package(s)
			rm -rf "${THIS}/AppDir~"

			mkdir -p "${THIS}/AppDir/etc/pkgup/installed"
			echo "${VER_NEW}" > "${VER}"

			echo "[pkgup] <- $1"
			return 25
		fi
	fi

	if [[ "$("${HELPER}" BREAK)" = *"CHANGES"* ]]
	then "[pkgup] break: CHANGES"
		if [ ! -f "${THIS}/AppDir/etc/pkgup/changes/${NAME}" ]
		then echo "`tput setaf 7`nothing`tput sgr0`" > "${THIS}/AppDir/etc/pkgup/changes/${NAME}"
		fi
	fi

	[[ "$("${HELPER}" BREAK)" = *"INTERRUPT"* ]] && exit 8
}

for i in tput wget git make gperf cmake pkg-config ninja meson
do
	if [ -z "$(which $i)" ]
	then echo "ERORR: lack of dependency: $i"
		exit 66
	fi
done
echo "--- ($(date)) $0 $@"
pkgup dest

cd "${_OLD}"
unset ROOT _OLD USECHAWAN ARCHT ARCHM
