#!/usr/bin/env bash
# base (one shared script file) should be in "${ROOT}/base", and it been
# been sourced in "${ROOT}/src/${package_name}.sh" files
_PWD="$(pwd)"
ARCHT="${ARCHT:-$(gcc -dumpmachine)}"
ARCHM="${ARCHM:-$(uname -m)}"
ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export ARCHT ARCHM ROOT
RED="$(tput setaf 1)"
NORMAL="$(tput sgr0)"
declare -r RED NORMAL
cd "$ROOT" || exit
mkdir -p pool

while [ -n "$1" ]
do case "$1" in
	--with-cha|--with-chawan)
	export USECHAWAN=YES
	shift;;

	-v|--version)
	echo -n "git "
	git rev-parse HEAD
	exit 0;;

	-h|--help)
	cat <<EOD
usage: $0 {OPTION}

OPTIONS:
--with-cha  enables chawan support
--help      display this page
--version   display version
EOD
	exit 0;;
esac
done

pkgsub() {
	# usage: pkgsub NAME DEP
	test -n "$2" || return 7
	local NOUPD=1
	printf "[pkgup]  * %s: %s" "$1" "$2" # in [${DEPS[@]}]"
	# [ ! -f ... ] means that you should provide order in dependencies,
	# from specific (that has ranged, of course) to ranged.
	if [ ! -f "$ROOT/pool/$1/AppDir~/etc/pkgup/installed/$2" ]
	then echo
		pkgup "$2" && NOUPD=0
		# echo "[pkgup]  ? $2 $?"
		if [ ! -f "$ROOT/pool/$2/AppDir/etc/pkgup/installed/$2" ]
		then echo "[pkgup] <! $1 [ghost dependency: $2]"
			# NOUPD=1
			return 17
		fi
		cp -RTf "$ROOT/pool/$2/AppDir" "$ROOT/pool/$1/AppDir~"
	else echo " [already here]"
	fi
	return $NOUPD
}

pkgup() {
	local -r NAME="${1:-NONAME}"
	local -r HELPER="$ROOT/src/$NAME.sh" # NAME=$1
	#local -r THIS="$ROOT/pool/$NAME"
	test ! -f "$HELPER" && exit 13 # FAIL: dependency is not found
	# shellcheck source=/dev/null
	source "$HELPER" # Is a script from #src/
	"$HELPER" setup
	echo "[pkgup] -> $NAME [ ${SYSDEPS[*]} | ${LIBDEPS[*]} | ${DEPS[*]} ]"
	for i in $SYSDEPS
	do
		if [ -n "$i" ] && [ -z "$(which "$i")" ]
		then echo "${RED}[pkgup] <! $NAME$NORMAL [nobin: $i]"
			return 67
		fi
	done

	for i in "${LIBDEPS[@]}"
	do
		[ -z "$i" ] \
		|| pkg-config "$i" \
		|| pkgconf "$i" \
		|| (echo "${RED}[pkgup] <! $NAME$NORMAL [nolib: $i]" ; false) \
		|| return 68
	done

	mkdir -p "$ROOT/pool/$NAME"
	cd "$ROOT/pool/$NAME" || return 1
	local UPD=0

	if   [ ! -d "$ROOT/pool/$NAME/src" ]
	then # Package is new
		mkdir -p "$ROOT/pool/$NAME/src"
		cd "$ROOT/pool/$NAME/src" || return 5
		"$HELPER" init
		UPD=1
	fi

	[ ! -d "$ROOT/pool/$NAME/AppDir" ] && UPD=1 # Package is also new

	# So $VER_FILE is both marker that package localy installed and its version
	# also changes should be in "$ROOT/pool/$NAME/AppDir/etc/pkgup/changes/$NAME"

	local VER_FILE VER_USED VER_NEW
	mkdir -p "$ROOT/pool/$NAME"/AppDir{,'~'}/etc/pkgup/{installed,changes}
	VER_FILE="$ROOT/pool/$NAME/AppDir/etc/pkgup/installed/$NAME"
	touch "$VER_FILE"
	VER_USED="$(cat "$VER_FILE")"
	cd "$ROOT/pool/$NAME/src" || return 2
	VER_NEW="$("$HELPER" update)"

	for DEP in "${DEPS[@]}"
	do pkgsub "$NAME" "$DEP" && UPD=1
	done

	if   [ "$UPD" == 1 ] || [ "$VER_USED" != "$VER_NEW" ]
	then # Updated or is new or is not $DEST
		echo "[pkgup] ^^ $NAME \"$VER_NEW\""
		cd "$ROOT/pool/$NAME/AppDir/etc/pkgup/changes/"  || return 3
		if [ -n "$(ls)" ]
		then for i in *
			do cat "$i" >> "$ROOT/pool/$NAME/AppDir~/etc/pkgup/changes/$i"
			done
		fi
		rm -rf "$ROOT/pool/$NAME/AppDir"
		mv -T "$ROOT/pool/$NAME/AppDir~" "$ROOT/pool/$NAME/AppDir"

		mkdir -p "$ROOT/pool/$NAME/AppDir/etc/pkgup/installed"
		echo "$VER_NEW" > "$VER_FILE"

		cd "$ROOT/pool/$NAME/src" || return 4
		"$HELPER" build || ( rm "$VER_FILE"; echo "${RED}[pkgup] <! $NAME$NORMAL [nobuild]" ; false) \
		|| ("$HELPER" why-no-build ; false) || exit 17
		echo "[pkgup] <+ $NAME"

	else # Nothing happens with package(s)
		rm -rf "$ROOT/pool/$NAME/AppDir~"

		mkdir -p "$ROOT/pool/$NAME/AppDir/etc/pkgup/installed"
		echo "$VER_NEW" > "$VER_FILE"

		echo "[pkgup] <- $NAME"
		return 25
	fi
}

mkdir -p "$ROOT/log"
DATE="--- ($(date "+%Y%m%dT%H%M%S")) $0 $*"
echo "$DATE"
>> "$ROOT/log/1" echo "$DATE"
>> "$ROOT/log/2" echo "$DATE"
unset DATE

which >/dev/null 2>/dev/null
if [ "$?" != '1' ]
then
	echo "[pkgup] b! which"
	exit 66
fi

pkgup dest

>> "$ROOT/log/1" echo
>> "$ROOT/log/2" echo

cd "$_PWD" || exit 8
unset ROOT _PWD USECHAWAN ARCHT ARCHM
