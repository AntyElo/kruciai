#!/usr/bin/env bash

if [ -f "$APPDIR/etc/pkgup/features" ]
then . "$APPDIR/etc/pkgup/features"
fi

# Setup env
_PATH="$PATH"
export PATH="$APPDIR/usr/bin:${_PATH}"

_MANPATH="${MANPATH:-/usr/share/man}"
export MANPATH="$APPDIR/usr/share/man:${_MANPATH}"

_TEXTDOMAINDIR="$TEXTDOMAINDIR"
export TEXTDOMAINDIR="$APPDIR"/usr/share/locale"${TEXTDOMAINDIR:+:$TEXTDOMAINDIR}"

#export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-$HOME/.local/share:/usr/local/share:/usr/share}"
if [ -e "$APPDIR/etc/pkgup/installed/chawan" ]
then HAD_CHAWAN="true"
fi

_NOTHING="$(tput setaf 7)Nothing$(tput sgr0)$(printf '\n')"

display_file() {
	printf "─── %s\n" "$1"
	if [ -s "$1" ]
	then cat "$1"
	else printf "%s" "$1" "${_NOTHING}"
	fi
	printf "\n"
}

display_files() {
	local _PWD="$(pwd)"
	cd "$1"
	shift 1
	if [ -n "$*" ]
	then
		for i in "$@"
		do display_file "$i"
		done
	else
		for i in *
		do display_file "$i"
		done
	fi
	cd "${_PWD}"
}

display_files_compressed() {
	local N="$1"
	shift
	display_files "$APPDIR/etc/pkgup/$N" "$@" > "/tmp/kruciai-$N"
	less -FR "/tmp/kruciai-$N"
	rm "/tmp/kruciai-$N"
}

is_present() {
	for D in "$@"
	do
		if [ ! -e "$APPDIR/etc/pkgup/installed/$D"  ]
		then
			printf '%s is not installed\n' "$D"
			return 127
		fi
	done
}

case "$1" in
	''|h|-h|help|--help)
	Q="'"
	printf "%s" "using: $(basename $0) COMMAND [ ARGS ... ]

commands:       description:

sh, shell       runs shell. To change dir to appimage root type \`cd \$APPDIR\`
mane            display manpage
mane-tree       display available manpages (wrapper around system \`tree\`)
help            display this help page
log             list recent changes of programs
list            list installed programs

qjs[c]          runs quickjs$Q repl or compiler
elinks          runs elinks web-browser${HAD_CHAWAN:+
cha, chawan     runs chawan
mancha          runs chawan$Qs wrapper for manpages}
"; unset Q;;

	sh|shell) shift
	${SHELL:=bash} "$@"
	;;

	qjs|qjsc) NAME=$1; shift
	is_present quickjs || exit 127
	"$APPDIR/usr/bin/$NAME" "$@"
	unset "$NAME"
	;;

	w|web|elinks) shift
	is_present elinks || exit 127
	if [ ! -d "$HOME/.config/elinks" ]; then
		cp -r "$APPDIR/etc/elinks" "$HOME/.config/elinks"
	fi
	"$APPDIR/usr/bin/elinks" "$@"
	;;

	cha|chawan) shift
	is_present chawan || exit 127
	"$APPDIR/usr/bin/cha" "$@"
	;;

	mane) shift
	is_present elinks || exit 127
	declare not_found
	for N in "$@"
	do  for F in "$APPDIR/usr/share/mane"/*/"$N".*html
		do if [ -f "$F" ]
			then "$APPDIR/usr/bin/elinks" "$F"
			else printf 'manpage "%s" not found\n' "$N"
				not_found=1
			fi
		done
	done
	test -n "$not_found" && printf '\ntip: use kruciai mane-tree to list manpages\n'
	unset not_found
	;;

	man) shift
	man -H"$APPDIR/usr/bin/elinks" "$@"
	;;

	mane-tree)
	tree "$APPDIR/usr/share/mane"
	;;

	man-tree)
	tree "$APPDIR/usr/share/man"
	;;

	mancha) shift
	is_present chawan || exit 127
	"$APPDIR/usr/bin/mancha" "$@"
	;;

	kc|changes|log) shift
	display_files_compressed changes "$@"
	;;

	ki|installed|list) shift
	display_files_compressed installed "$@"
	;;

	*) echo "command \"$*\" not recognized" ;;
esac

export PATH="${_PATH}"
export MANPATH="${_MANPATH}"
export TEXTDOMAINDIR="${_TEXTDOMAINDIR}"
