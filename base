#!/usr/bin/env bash

# Samples for "update) ;;"
update-hook0() {
	mkdir -p "${ROOT}/pool/$1/AppDir/etc/pkgup/changes/"
	if [ ! -f "${ROOT}/pool/$1/AppDir/etc/pkgup/changes/$1" ]
	then echo `tput setaf 7`"Nothing"`tput sgr0` > "${ROOT}/pool/$1/AppDir/etc/pkgup/changes/$1"
	fi
}

update-git() {
	update-hook0 "$1"
	local CHANGES="$( git pull 1>&2 ; git log ORIG_HEAD.. 2>&1 )"
	if [ -n "${CHANGES}" ]
	then echo "${CHANGES}" > "${ROOT}/pool/$1/AppDir/etc/pkgup/changes/$1"
	fi
	echo -n "git "
	git rev-parse HEAD
}

update-git-src() {
	# Use $2 (e.g. CHANGELOG) as source of changes
	cat "${ROOT}/pool/$1/src/$2" > "${ROOT}/pool/$1/AppDir/etc/pkgup/changes/$1"
	echo -n "git "
	git rev-parse HEAD
}

# Samples for "build) ;;"
build-meson() {
	# Usage: mesons "${NAME}" "${MESONFLAGS[@]}"
	echo "[base] do build-meson [$0]" "$@"
	local NAME="$1"
	shift 1

	cd "${SRC:-${ROOT}/pool/${NAME}/src}"
	local ENV="$(pwd)/../AppDir"
	rm -rf build

	meson setup "$@" build \
	-Dcmake_prefix_path="${ENV}/usr:${ENV}" \
	-Dpkg_config_path="${ENV}/usr/lib/${ARCHT}/pkgconfig:${ENV}/usr/lib/pkgconfig:${ENV}/lib/pkgconfig" \
	-Dcpp_args="-I${ENV}/usr/include/quickjs-ng -I${ENV}/usr/include -I${ENV}/include" \
	-Dc_args="-I${ENV}/usr/include/quickjs-ng -I${ENV}/usr/include -I${ENV}/include" \
	-Dcpp_link_args="-L${ENV}/usr/lib/${ARCHT} -L${ENV}/usr/lib -L${ENV}/lib" \
	-Dc_link_args="-L${ENV}/usr/lib/${ARCHT} -L${ENV}/usr/lib -L${ENV}/lib" \
	--prefix="${ENV}/usr" \
	|| { ${TAIL:-tail -n 20} build/meson-logs/meson-log.txt; }

	local NPROC="$(nproc)"
	meson compile -j $(((${NPROC:-2} - 1))) -C build

	meson install -C build
}